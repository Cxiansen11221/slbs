page {
  background: linear-gradient(180deg, #f3f6ff 0%, #f8f2ec 100%);
}

.chat-page {
  height: 100vh;
  padding: 20rpx 20rpx calc(120rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.top-panel {
  background: rgba(255, 255, 255, 0.72);
  border: 1rpx solid #e9eef7;
  border-radius: 26rpx;
  padding: 14rpx;
  box-shadow: 0 8rpx 20rpx rgba(43, 59, 92, 0.07);
}

.solution-card {
  background: #fff;
  border-radius: 20rpx;
  border: 1rpx solid #ecf0f7;
  padding: 18rpx 18rpx 18rpx;
}

.solution-header {
  display: flex;
  align-items: center;
}

.solution-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 12rpx;
  background: linear-gradient(135deg, #2f80ed 0%, #5a9df4 100%);
  color: #fff;
  line-height: 42rpx;
  text-align: center;
  font-size: 26rpx;
  font-weight: 700;
  margin-right: 12rpx;
}

.solution-title {
  font-size: 34rpx;
  color: #1f2d48;
  font-weight: 600;
}

.solution-topic {
  margin-top: 14rpx;
  text-align: center;
  color: #293344;
  font-size: 38rpx;
  font-weight: 600;
}

.solution-subtopic {
  margin-top: 6rpx;
  text-align: center;
  color: #97a0b2;
  font-size: 26rpx;
}

.action-btn {
  margin-top: 12rpx;
  height: 70rpx;
  border-radius: 36rpx;
  border: 1rpx solid #ecf0f7;
  background: #fff;
  color: #d49444;
  text-align: center;
  line-height: 70rpx;
  font-size: 30rpx;
  font-weight: 600;
}

.more-row {
  margin-top: 18rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.more-label {
  font-size: 28rpx;
  color: #7b8599;
}

.shuffle-btn {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 14rpx;
  border-radius: 16rpx;
  border: 1rpx solid #dde5f2;
  background: #fff;
  font-size: 24rpx;
  color: #4f5f7e;
}

.shuffle-icon {
  font-size: 24rpx;
}

.faq-list {
  margin-top: 8rpx;
}

.faq-row {
  width: 100%;
  display: flex;
  justify-content: flex-start;
}

.faq-item {
  margin-top: 12rpx;
  min-width: 320rpx;
  max-width: 540rpx;
  min-height: 78rpx;
  border-radius: 40rpx;
  border: 1rpx solid #e2e8f3;
  background: #fff;
  box-shadow: 0 6rpx 14rpx rgba(37, 50, 80, 0.08);
  padding: 0 22rpx;
  display: inline-flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.faq-text {
  max-width: 430rpx;
  font-size: 31rpx;
  color: #32405a;
  line-height: 1.3;
}

.faq-arrow {
  margin-left: 14rpx;
  font-size: 32rpx;
  color: #f4a03f;
  font-weight: 700;
}

.dialog-scroll {
  flex: 1;
  min-height: 0;
}

.scroll-content {
  padding-bottom: 16rpx;
}

.chat-area {
  padding-top: 16rpx;
  padding-bottom: 16rpx;
}

.msg-row {
  width: 100%;
  display: flex;
  margin-top: 16rpx;
}

.msg-row.user {
  justify-content: flex-end;
}

.msg-row.service {
  justify-content: flex-start;
}

.msg-bubble {
  max-width: 560rpx;
  border-radius: 18rpx;
  padding: 16rpx 18rpx;
  line-height: 1.55;
  font-size: 30rpx;
  word-break: break-all;
}

.msg-bubble.user {
  background: linear-gradient(135deg, #fbeede 0%, #f6e5d1 100%);
  color: #4d3f31;
}

.msg-bubble.service {
  background: #fff;
  border: 1rpx solid #dfe6f2;
  color: #2e3f5a;
}

.composer {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(12rpx + env(safe-area-inset-bottom));
  height: 96rpx;
  border-radius: 18rpx;
  background: rgba(243, 247, 255, 0.98);
  border: 1rpx solid #dce5f4;
  padding: 10rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  z-index: 100;
}

.composer-input {
  flex: 1;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 36rpx;
  background: #fff;
  border: 1rpx solid #e2e9f6;
  padding: 0 20rpx;
  font-size: 30rpx;
  color: #34425d;
}

.send-btn {
  margin-left: 10rpx;
  width: 104rpx;
  height: 72rpx;
  border-radius: 36rpx;
  background: linear-gradient(135deg, #f0d687 0%, #e3be54 100%);
  color: #3b3a34;
  text-align: center;
  line-height: 72rpx;
  font-size: 28rpx;
  font-weight: 600;
}
