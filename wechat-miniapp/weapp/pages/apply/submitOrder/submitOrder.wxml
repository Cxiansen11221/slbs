<!-- pages/apply/submitOrder/submitOrder.wxml -->
<view class="page">
  <view class="card vehicle-card">
    <view class="vehicle-name">提交订单</view>
    <view class="vehicle-sub">{{orderInfo.vehicleName}}</view>
    <view class="vehicle-sub">{{orderInfo.bikeType}} · {{orderInfo.priceText}}</view>
    <view class="address">{{orderInfo.address}}</view>
  </view>

  <view class="card">
    <view class="section-title">取车方式</view>
    <view class="pickup-row">
      <view class="pickup-item {{form.pickupType==='store' ? 'active' : ''}}" data-type="store" bindtap="changePickupType">到店取车</view>
      <view class="pickup-item {{form.pickupType==='delivery' ? 'active' : ''}}" data-type="delivery" bindtap="changePickupType">送车上门</view>
    </view>
    <view class="hint" wx:if="{{form.pickupType==='delivery'}}">配送费：¥20</view>
  </view>

  <view class="card">
    <view class="section-title">租赁信息</view>
    <view class="rent-type-row">
      <view class="rent-type-item {{form.rentalType===4 ? 'active' : ''}}" data-type="4" bindtap="changeRentalType">月租</view>
      <view class="rent-type-item {{form.rentalType===2 ? 'active' : ''}}" data-type="2" bindtap="changeRentalType">日租</view>
      <view class="rent-type-item {{form.rentalType===1 ? 'active' : ''}}" data-type="1" bindtap="changeRentalType">时租</view>
    </view>
    <picker mode="date" value="{{form.startDate}}" bindchange="onStartDateChange">
      <view class="input-row">
        <text>开始日期</text>
        <text class="value">{{form.startDate || '请选择'}}</text>
      </view>
    </picker>
    <picker mode="date" value="{{form.endDate}}" bindchange="onEndDateChange">
      <view class="input-row">
        <text>结束日期</text>
        <text class="value">{{form.endDate || '请选择'}}</text>
      </view>
    </picker>
    <input class="text-input" placeholder="姓名" value="{{form.name}}" data-key="name" bindinput="onInput" />
    <input class="text-input" placeholder="手机号" type="number" maxlength="11" value="{{form.mobile}}" data-key="mobile" bindinput="onInput" />
  </view>

  <view class="card">
    <view class="section-title">押金信息</view>
    <view class="input-row">
      <text>押金金额</text>
      <input class="inline-input" type="digit" value="{{form.depositAmount}}" bindinput="onDepositInput" />
    </view>
    <view class="fee-row">
      <text>租金小计</text>
      <text>{{fee.rentAmountText}}</text>
    </view>
    <view class="fee-row">
      <text>服务费</text>
      <text>{{fee.serviceFeeText}}</text>
    </view>
    <view class="fee-row total">
      <text>应付总额（含押金）</text>
      <text>{{fee.payableAmountText}}</text>
    </view>
  </view>

  <view class="footer">
    <view class="price">{{fee.payableAmountText}}</view>
    <button class="submit-btn" bindtap="submitOrder">提交订单</button>
  </view>
</view>
