/* pages/apply/submitOrder/submitOrder.wxss */
page {
  background: #f6f7fb;
}

.page {
  min-height: 100vh;
  padding: 20rpx;
  padding-bottom: calc(150rpx + env(safe-area-inset-bottom));
}

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.vehicle-card {
  background: #fff7ed;
}

.vehicle-name {
  font-size: 34rpx;
  font-weight: 700;
  color: #111827;
}

.vehicle-sub {
  margin-top: 8rpx;
  color: #6b7280;
  font-size: 24rpx;
}

.address {
  margin-top: 8rpx;
  color: #334155;
  font-size: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 14rpx;
}

.pickup-row {
  display: flex;
  gap: 14rpx;
}

.pickup-item {
  flex: 1;
  height: 76rpx;
  line-height: 76rpx;
  text-align: center;
  border-radius: 12rpx;
  border: 1rpx solid #d1d5db;
  color: #374151;
}

.pickup-item.active {
  border-color: #f59e0b;
  color: #d97706;
  background: #fffbeb;
}

.hint {
  margin-top: 12rpx;
  color: #f97316;
  font-size: 22rpx;
}

.rent-type-row {
  display: flex;
  gap: 14rpx;
  margin-bottom: 12rpx;
}

.rent-type-item {
  flex: 1;
  text-align: center;
  height: 68rpx;
  line-height: 68rpx;
  border: 1rpx solid #d1d5db;
  border-radius: 999rpx;
  color: #4b5563;
  font-size: 24rpx;
}

.rent-type-item.active {
  border-color: #f97316;
  background: #fff7ed;
  color: #ea580c;
}

.input-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  height: 76rpx;
  border-bottom: 1rpx solid #eef2f7;
  font-size: 26rpx;
  color: #111827;
}

.inline-input {
  width: 240rpx;
  text-align: right;
  font-size: 26rpx;
  color: #111827;
}

.value {
  color: #6b7280;
}

.text-input {
  height: 76rpx;
  border-bottom: 1rpx solid #eef2f7;
  font-size: 26rpx;
}

.fee-row {
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  color: #334155;
  font-size: 24rpx;
}

.fee-row.total {
  margin-top: 8rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid #eef2f7;
  font-size: 26rpx;
  color: #111827;
  font-weight: 600;
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  background: #fff;
  padding: 14rpx 20rpx calc(14rpx + env(safe-area-inset-bottom));
  display: flex;
  align-items: center;
  gap: 20rpx;
  box-shadow: 0 -6rpx 18rpx rgba(15, 23, 42, 0.08);
}

.price {
  flex: 1;
  font-size: 46rpx;
  color: #ef4444;
  font-weight: 700;
}

.submit-btn {
  width: 280rpx;
  height: 82rpx;
  line-height: 82rpx;
  border-radius: 12rpx;
  background: #f97316;
  color: #fff;
  font-size: 30rpx;
  border: 0;
}

.submit-btn::after {
  border: 0;
}
