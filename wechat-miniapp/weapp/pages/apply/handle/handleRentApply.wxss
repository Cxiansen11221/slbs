/* pages/apply/handle/handleRentApply.wxss */
page {
  background: #f3f4f6;
}

.page {
  min-height: 100vh;
  padding-bottom: calc(170rpx + env(safe-area-inset-bottom));
}

.content {
  padding: 16rpx 18rpx 0;
}

.statePanel {
  margin: 100rpx 30rpx 0;
  text-align: center;
  color: #6b7280;
  font-size: 30rpx;
}

.imageBox {
  border-radius: 16rpx;
  overflow: hidden;
}

.picSwiper {
  height: 380rpx;
}

.card {
  margin-top: 16rpx;
  background: #fff;
  border-radius: 14rpx;
  padding: 20rpx;
  box-shadow: 0 6rpx 18rpx rgba(15, 23, 42, 0.06);
}

.compact {
  padding-top: 16rpx;
  padding-bottom: 16rpx;
}

.priceText {
  text-align: center;
  font-size: 52rpx;
  font-weight: 700;
  color: #ef4444;
}

.divider {
  border-top: 1rpx solid #dbeafe;
  margin: 18rpx 0;
}

.title {
  font-size: 32rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 12rpx;
}

.line {
  font-size: 27rpx;
  color: #334155;
  line-height: 1.8;
}

.statusRow,
.depositRow {
  display: flex;
  align-items: center;
}

.depositRow {
  margin-top: 12rpx;
}

.label {
  color: #4b5563;
}

.deposit {
  font-size: 42rpx;
  color: #111827;
  font-weight: 700;
}

.footerBtns {
  position: fixed;
  left: 18rpx;
  right: 18rpx;
  bottom: calc(16rpx + env(safe-area-inset-bottom));
  z-index: 20;
}

.footerBtns .i-btn {
  width: 100% !important;
}

.footerBtns.double {
  display: flex;
  gap: 14rpx;
}

.footerBtns.double .i-btn {
  flex: 1;
  width: auto !important;
}

.btnText {
  text-align: center;
}
