<!--pages/userInfo/manageLogin/login.wxml-->
<view class="loginPage">
  <view class="systemInfo">
    <view class="systemTitle">{{systemName}}</view>
    <view class="systemLogo">
      <image src="{{picLocal+systemLogo}}" wx:if="{{systemLogo}}"></image>
    </view>
  </view>
  <view class="form">
    <i-input value="{{ loginName }}" type="text" title="账户" placeholder="请输入账户" maxlength="20" bind:change="loginNameChange" i-class="loginInput"/>
    <view class="i-class i-cell i-input loginInput password-field">
      <view class="i-cell-hd i-input-title">密码</view>
      <input
        class="i-input-input i-cell-bd password-input"
        type="text"
        password="{{!showPassword}}"
        placeholder="请输入密码"
        placeholder-class="i-input-placeholder"
        maxlength="20"
        value="{{ password }}"
        bindinput="passwordInput"
      />
      <image
        class="password-eye"
        src="{{ showPassword ? eyeOpenIcon : eyeClosedIcon }}"
        bindtap="togglePassword"
        mode="aspectFit"
      />
    </view>
  </view>
  <view class="funBtn">
    <button class="wx-auth-login-btn login-submit-btn" bindtap="login">登录</button>
  </view>
  <view class="wechatLogin">
    <button class="wx-auth-login-btn" open-type="getPhoneNumber" bindgetphonenumber="wechatLogin">微信登录</button>
  </view>
  <view class="welcome-box">欢迎使用易租车</view>
  <view class="tip"></view>
</view>
