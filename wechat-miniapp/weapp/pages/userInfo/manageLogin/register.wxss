/* pages/userInfo/manageLogin/register.wxss */
.systemInfo{
  width: 80%;
  margin: 0 auto;
}

.systemTitle{
  text-align: center;
  font-family: 楷体;
  font-size: 40rpx;
}

.systemLogo{
  margin: 0 auto;
  
}

.form{
  width: 80%;
  margin: 0 auto;
}

page{
  background-color: #F5F5F5;
}

.loginInput{
  margin: 20rpx;
}

.password-field{
  position: relative;
  padding: 4px 5px;
  display: flex;
  background: #fff;
  align-items: center;
  line-height: 1.4;
  font-size: 14px;
  overflow: hidden;
}

.password-field::after{
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  width: 200%;
  height: 200%;
  transform: scale(0.5);
  transform-origin: 0 0;
  pointer-events: none;
  box-sizing: border-box;
  border: 0 solid #e9eaec;
  border-bottom-width: 1px;
  left: 15px;
  right: 0;
}

.password-field .i-cell-bd{
  flex: 1;
}

.password-field .i-input-title{
  color: #495060;
  min-width: 65px;
  padding-right: 10px;
}

.password-input{
  padding-right: 60rpx;
  line-height: 1.6;
  padding-top: 4px;
  padding-bottom: 4px;
  min-height: 22px;
  height: auto;
  font-size: 14px;
  flex: 1;
}

.password-field .i-input-placeholder{
  font-size: 14px;
}

.password-eye{
  position: absolute;
  right: 6rpx;
  top: 50%;
  width: 36rpx;
  height: 36rpx;
  transform: translateY(-50%);
  opacity: 0.6;
}

.password-eye:active{
  opacity: 1;
}

.btnText{
  width: 200rpx;
}

.funBtn,
.wechatLogin {
  display: flex;
  justify-content: center;
}

.funBtn {
  margin: 170rpx 0 20rpx 0;
}

.wechatLogin {
  margin: 20rpx 0 20rpx 0;
}

.wx-auth-login-btn {
  min-width: 320rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  border: 0;
  color: #ffffff;
  font-size: 28rpx;
  background: linear-gradient(135deg, #2f88ff 0%, #0d6ee9 100%);
}

.wx-auth-login-btn::after {
  border: 0;
}

.login-submit-btn{
  background: #21c36a;
}

.welcome-box{
  width: 86%;
  margin: 320rpx auto 0;
  padding: 30rpx 18rpx;
  text-align: center;
  color: #1f3a5f;
  font-size: 32rpx;
  font-weight: 600;
  background: #e7f2ff;
  border: 2rpx solid #cfe4ff;
  border-radius: 16rpx;
}
