<!-- pages/userInfo/rentRecord/rentRecord.wxml -->
<view class="page">
  <view wx:if="{{loading}}" class="statePanel">加载中...</view>
  <view wx:elif="{{loadError}}" class="statePanel">{{loadError}}</view>
  <view wx:elif="{{orderList.length===0}}" class="statePanel">暂无订单记录</view>

  <view wx:else class="list">
    <view class="orderCard {{item.isFocus ? 'focus' : ''}}" wx:for="{{orderList}}" wx:key="id">
      <view class="topRow">
        <text class="orderCode">订单号：{{item.orderCode}}</text>
        <text class="status">{{item.statusText}}</text>
      </view>
      <view class="row"><text class="label">订单ID</text><text class="value">{{item.id}}</text></view>
      <view class="row"><text class="label">车辆ID</text><text class="value">{{item.vehicleId}}</text></view>
      <view class="row"><text class="label">取车时间</text><text class="value">{{item.startTime}}</text></view>
      <view class="row"><text class="label">还车时间</text><text class="value">{{item.endTime}}</text></view>
      <view class="row"><text class="label">订单金额</text><text class="amount">{{item.amountText}}</text></view>
      <view class="actionRow" wx:if="{{item.canPay || item.canCancel || item.canDelete}}">
        <button wx:if="{{item.canPay}}" class="payBtn" data-id="{{item.id}}" data-amount="{{item.amountValue}}" bindtap="startMockPay">立即支付</button>
        <button wx:if="{{item.canCancel}}" class="cancelBtn" data-id="{{item.id}}" bindtap="cancelOrder">取消订单</button>
        <button wx:if="{{item.canDelete}}" class="deleteBtn" data-id="{{item.id}}" bindtap="deleteOrder">删除订单</button>
      </view>
    </view>
  </view>
</view>

