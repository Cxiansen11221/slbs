page {
  background-color: var(--color-background);
  font-family: 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
}

.myPage {
  padding: 20rpx;
  padding-bottom: 280rpx;
}

.soft-message {
  background: linear-gradient(135deg, #5fb2ff 0%, #2f8fff 100%) !important;
  color: #ffffff !important;
  box-shadow: 0 8rpx 18rpx rgba(47, 143, 255, 0.28);
}

.user-card {
  background-color: var(--color-white);
  border-radius: 18rpx;
  box-shadow: 0 8rpx 26rpx rgba(15, 23, 42, 0.08);
  margin-bottom: 24rpx;
  overflow: hidden;
}

.card-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx;
  position: relative;
  background: linear-gradient(140deg, #0f7fff 0%, #0b63dc 100%);
  color: #fff;
}

.infoPic {
  width: 116rpx;
  height: 116rpx;
  flex-shrink: 0;
}

.headPic {
  width: 116rpx;
  height: 116rpx;
  border-radius: 50%;
  border: 4rpx solid rgba(255, 255, 255, 0.92);
  box-shadow: 0 8rpx 18rpx rgba(0, 0, 0, 0.15);
  background: rgba(255, 255, 255, 0.25);
}

.user-details {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.name-section {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.userName {
  max-width: 70%;
  font-size: 34rpx;
  font-weight: 600;
  color: #fff;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}

.userName.ghost {
  color: rgba(255, 255, 255, 0.95);
}

.gender {
  opacity: 0.95;
}

.user-tip {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.88);
}

.userRole {
  margin-top: 12rpx;
}

.userRole .i-tags {
  background-color: rgba(255, 255, 255, 0.22) !important;
  color: #fff !important;
}

.loginBtn {
  width: 164rpx !important;
  height: 54rpx !important;
  line-height: 54rpx !important;
  font-size: 24rpx !important;
  border-radius: 999rpx !important;
  background-color: #fff !important;
  color: #0d6ee9 !important;
}

.wechat-auth-btn {
  width: auto;
  min-width: 140rpx;
  height: 48rpx;
  line-height: 48rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  border: 0;
  font-size: 22rpx;
  color: #0d6ee9;
  background: #ffffff;
  margin: 0;
  display: inline-flex;
  align-items: center;
  justify-content: center;
}

.wechat-auth-btn::after {
  border: 0;
}

.btnAround {
  margin-top: 18rpx;
  display: flex;
  justify-content: flex-start;
  align-items: center;
}

.profile-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  height: 54rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #fff;
  border: 1rpx solid rgba(255, 255, 255, 0.75);
}

.header-edit {
  position: absolute;
  right: 20rpx;
  top: 20rpx;
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  height: 48rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  color: #fff;
  font-size: 22rpx;
  background: rgba(255, 255, 255, 0.18);
  border: 1rpx solid rgba(255, 255, 255, 0.38);
}

.card-stats {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 0;
  background: #fff;
}

.stat-item {
  text-align: center;
  padding: 24rpx 8rpx 22rpx;
  border-right: 1rpx solid #eef1f6;
}

.stat-item:last-child {
  border-right: 0;
}

.count {
  font-size: 40rpx;
  line-height: 1;
  font-weight: 700;
  color: #0d6ee9;
}

.title {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #4b5563;
}

.funList {
  background-color: #fff;
  border-radius: 18rpx;
  box-shadow: 0 8rpx 26rpx rgba(15, 23, 42, 0.06);
  padding: 20rpx 16rpx 12rpx;
  margin-top: 34rpx;
}

.section-title {
  padding: 6rpx 10rpx 14rpx;
  font-size: 26rpx;
  font-weight: 600;
  color: #1f2937;
}

.grid-container {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 10rpx;
}

.grid-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-height: 138rpx;
  border-radius: 12rpx;
}

.grid-item:active {
  background: #f2f6ff;
}

.grid-icon {
  width: 62rpx;
  height: 62rpx;
  border-radius: 16rpx;
  margin-bottom: 10rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #eaf3ff;
}

.quick-icon {
  width: 34rpx;
  height: 34rpx;
}

.grid-label {
  font-size: 23rpx;
  color: #334155;
  text-align: center;
  line-height: 1.3;
}

.funBtn {
  position: fixed;
  left: 20rpx;
  right: 20rpx;
  bottom: calc(110rpx + env(safe-area-inset-bottom));
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  z-index: 20;
}

.wechat-login-btn {
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-family: var(--font-medium);
  background: linear-gradient(135deg, #b7dcff 0%, #8fc8ff 100%);
  color: #ffffff !important;
  border: 0;
  box-shadow: 0 8rpx 16rpx rgba(143, 200, 255, 0.3);
}

.wechat-login-btn::after {
  border: 0;
}

.logout-btn {
  height: 78rpx;
  line-height: 78rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #475569;
  background: #eef2f8;
  border: 1rpx solid #d8e1ef;
}

.logout-btn::after {
  border: 0;
}

.switch-login-btn {
  height: 78rpx;
  line-height: 78rpx;
  border-radius: 12rpx;
  font-size: 28rpx;
  color: #0d6ee9;
  background: #eaf3ff;
  border: 1rpx solid #cfe1ff;
}

.switch-login-btn::after {
  border: 0;
}
