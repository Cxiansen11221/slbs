/* pages/userInfo/viewed/viewed.wxss */
.bikeCard{
  padding-top: 20rpx;
  padding-bottom: 20rpx;
  margin: 20rpx 30rpx;
  height: 220rpx;
  background-color:white;
  box-shadow: 0 4px 8px 0 rgba(0,0,0,0.2);
  transition: 0.3s;
  display: flex;
  border-radius: 10rpx;
}

.bikePic{
  display: inline;
}

.bikeInfo{
  display: flex;
}

.infoTitle{
  height: 40rpx;
  font-size: 25rpx;
  font-family: 'Courier New', Courier, monospace;
  flex-basis: 100%;
  margin-left: 20rpx;
}

.tagInfo{
  display: block;
}

.bikePrice{
  display: flex;
  font-family: 'Courier New', Courier, monospace;
  font-size: 25rpx;
  margin-left: 110rpx;
}
.price{
  font-size: 40rpx;
  color: red;
  font-family:'Times New Roman', Times, serif
}
.priceUnit{
  margin-top: 15rpx;
  margin-left: 10rpx;
}
.addTitle{
  flex: 1;

}
.addressDetail{
  flex: 5;
}
.distance{
  font-family: 'Courier New', Courier, monospace;
  font-size: 20rpx;
  display: flex;
}


.bikePic>image{
  margin: 25rpx 30rpx;
}

i-tag{
  width: auto;
  margin: 0 15rpx;
}

.recommendTitle{
  font-size: 40rpx;
  font-family:'Times New Roman', Times, serif;
  align-items:flex-start;
  margin-left: 30rpx;
  margin-top: 20rpx;
}

page{
  background-color: #EEEEEE;
}

.collectionPage {
  padding: 16rpx;
}

.empty {
  margin: 120rpx 24rpx;
  text-align: center;
  color: #7c8ea8;
  font-size: 28rpx;
}

.bikeInfo {
  flex: 1;
  padding-right: 16rpx;
}

.bikePic image {
  width: 210rpx;
  height: 190rpx;
  border-radius: 12rpx;
  margin: 14rpx 20rpx;
}

.priceText {
  color: #ef4444;
  font-weight: 700;
}

.actionRow {
  margin-top: 14rpx;
}

.removeBtn {
  width: 180rpx;
  height: 58rpx;
  line-height: 58rpx;
  margin: 0;
  background: #ffffff;
  border: 1rpx solid #dcdfe6;
  color: #f56c6c;
  border-radius: 29rpx;
  font-size: 24rpx;
  padding: 0;
}
