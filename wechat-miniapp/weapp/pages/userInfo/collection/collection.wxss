/* pages/userInfo/collection/collection.wxss */
page {
  background-color: #f3f4f6;
}

.collectionPage {
  padding: 18rpx 20rpx 26rpx;
}

.empty {
  margin: 120rpx 24rpx;
  text-align: center;
  color: #7c8ea8;
  font-size: 28rpx;
}

.bikeList {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.bikeCard {
  display: flex;
  background: #fff;
  border-radius: 14rpx;
  padding: 18rpx;
  box-shadow: 0 8rpx 20rpx rgba(15, 23, 42, 0.08);
}

.bikePic {
  width: 200rpx;
  height: 200rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #eef2f7;
}

.bikeInfo {
  flex: 1;
  margin-left: 16rpx;
  display: flex;
  flex-direction: column;
  justify-content: flex-start;
  gap: 6rpx;
  min-width: 0;
}

.row {
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.label {
  width: 120rpx;
  color: #6b7280;
  font-size: 23rpx;
  flex-shrink: 0;
}

.value {
  color: #111827;
  font-size: 24rpx;
  line-height: 1.45;
  flex: 1;
  min-width: 0;
  word-break: break-word;
}

.price {
  color: #ef4444;
  font-weight: 600;
}

.name-value {
  font-size: 26rpx;
  font-weight: 600;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.actionRow {
  margin-top: 10rpx;
}

.removeBtn {
  width: 180rpx;
  height: 58rpx;
  line-height: 58rpx;
  margin: 0;
  background: #ffffff;
  border: 1rpx solid #dcdfe6;
  color: #f56c6c;
  border-radius: 29rpx;
  font-size: 24rpx;
  padding: 0;
}
