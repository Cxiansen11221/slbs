<!-- pages/userInfo/changeMyInfo.wxml -->
<i-toast id="toast" />
<i-message id="message" />

<view class="edit-profile-container">
  <view class="profile-edit-card">
    <view class="avatar-section">
      <view class="avatar-uploader" bindtap="chooseImage">
        <image class="avatar-image" src="{{avatarDisplayUrl || defaultAvatar}}" mode="aspectFill" binderror="onAvatarError"></image>
      </view>
      <text class="avatar-hint">点击修改头像</text>
    </view>

    <view class="section-card">
      <view class="section-title">基本信息</view>
      <view class="form-item">
        <text class="form-label">ID</text>
        <input class="form-input disabled" value="{{user.displayId}}" disabled />
      </view>
      <view class="form-item">
        <text class="form-label">名字</text>
        <input class="form-input" value="{{user.name}}" placeholder="请输入名字" maxlength="20" bindinput="changeName" />
      </view>
      <view class="form-item">
        <text class="form-label">手机号</text>
        <input class="form-input" value="{{user.mobile}}" placeholder="请输入电话号码" maxlength="11" type="number" bindinput="changeMobile" />
      </view>
      <view class="form-item">
        <text class="form-label">邮箱</text>
        <input class="form-input" value="{{user.email}}" placeholder="请输入邮箱" maxlength="30" bindinput="changeEmail" />
      </view>
    </view>

    <view class="section-card">
      <view class="section-title">个人资料</view>
      <view class="form-item picker-item">
        <text class="form-label">角色</text>
        <picker class="form-picker" bindchange="rolePickerChange" value="{{roleIndex}}" range="{{allRole}}" range-key="label" disabled>
          <view class="picker-content">
            <text>{{allRole[roleIndex].label}}</text>
            <i-icon type="right" size="16" color="#999"></i-icon>
          </view>
        </picker>
      </view>
      <view class="form-item picker-item">
        <text class="form-label">出生日期</text>
        <picker class="form-picker" mode="date" bindchange="datePickerChange" value="{{user.birthday}}" start="1950-01-01" end="2099-12-31">
          <view class="picker-content">
            <text>{{user.birthday || '请选择出生日期'}}</text>
            <i-icon type="right" size="16" color="#999"></i-icon>
          </view>
        </picker>
      </view>
      <view class="form-item">
        <text class="form-label">性别</text>
        <picker class="form-picker" mode="selector" range="{{genderOptions}}" range-key="label" value="{{genderIndex}}" bindchange="genderPickerChange">
          <view class="picker-content">
            <text>{{genderOptions[genderIndex].label}}</text>
            <i-icon type="right" size="16" color="#999"></i-icon>
          </view>
        </picker>
      </view>
    </view>

    <view class="section-card">
      <view class="section-title">位置信息</view>
      <view class="form-item">
        <text class="form-label">详细地址</text>
        <input class="form-input" value="{{user.address}}" placeholder="请输入详细地址" maxlength="100" bindinput="changeAddress" />
      </view>
    </view>
  </view>

  <view class="action-buttons">
    <button class="btn submit-btn" bindtap="sureChange">保存修改</button>
  </view>

  <i-modal title="提示" visible="{{sureVisible}}" bind:ok="sureAlertOk" bind:cancel="sureAlertCancel">
    <view class="modal-content">确定要修改用户信息吗？</view>
  </i-modal>
</view>
