<view class="page">
  <view class="page-title">推荐专区</view>
  <view class="hero-card">
    <text class="hero-title">{{detail.title}}</text>
    <text class="hero-desc">{{detail.desc}}</text>
  </view>

  <view class="section">
    <view class="section-head">
      <text class="section-title">核心内容</text>
      <text class="section-sub">基于你的用车偏好整理</text>
    </view>
    <view class="point" wx:for="{{detail.points}}" wx:key="*this">
      <text class="dot"></text>
      <text class="point-text">{{item}}</text>
    </view>
  </view>
</view>
