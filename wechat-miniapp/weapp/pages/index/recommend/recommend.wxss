page {
  background: #f5faff;
  color: #333333;
}

.page {
  padding: 26rpx 22rpx 32rpx;
  box-sizing: border-box;
  min-height: 100vh;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333333;
  margin-bottom: 14rpx;
}

.hero-card {
  background: linear-gradient(160deg, #f9fbff 0%, #f4f8ff 60%, #f9f7f5 100%);
  border: 1rpx solid #cfe4f2;
  border-radius: 20rpx;
  padding: 24rpx 22rpx;
  box-shadow: 0 2rpx 10rpx rgba(189, 216, 232, 0.24);
}

.hero-title {
  font-size: 38rpx;
  font-weight: 600;
  color: #333333;
  display: block;
}

.hero-desc {
  margin-top: 10rpx;
  font-size: 28rpx;
  color: #5f6b75;
  display: block;
}

.section {
  margin-top: 20rpx;
  background: #ffffff;
  border: 1rpx solid #e6f0f7;
  border-radius: 16rpx;
  padding: 20rpx 18rpx;
  box-shadow: 0 2rpx 8rpx rgba(189, 216, 232, 0.2);
}

.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.section-title {
  font-size: 30rpx;
  color: #333333;
  font-weight: 600;
  display: block;
}

.section-sub {
  font-size: 24rpx;
  color: #999999;
}

.point {
  display: flex;
  align-items: flex-start;
  gap: 12rpx;
  padding: 6rpx 0;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #bfd8e8;
  margin-top: 10rpx;
  flex-shrink: 0;
}

.point-text {
  font-size: 28rpx;
  color: #333333;
  line-height: 1.6;
}
