.page {
  position: relative;
  width: 100%;
  height: 100vh;
  background: #f4f8ff;
}

.map {
  width: 100%;
  height: 100%;
}

.address {
  position: absolute;
  left: 20rpx;
  right: 20rpx;
  bottom: 24rpx;
  z-index: 10;
  padding: 12rpx 16rpx;
  border-radius: 999rpx;
  background: rgba(15, 23, 42, 0.72);
  color: #f8fbff;
  font-size: 24rpx;
  line-height: 1.5;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
