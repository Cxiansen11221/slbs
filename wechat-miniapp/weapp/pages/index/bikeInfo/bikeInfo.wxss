/* pages/index/bikeInfo/bikeInfo.wxss */
page {
  background: #f3f4f6;
  font-family: 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
}

.container {
  min-height: 100vh;
  padding-bottom: calc(190rpx + env(safe-area-inset-bottom));
}

.content {
  padding: 16rpx 18rpx 0;
}

.state {
  text-align: center;
  color: #64748b;
  padding: 60rpx 20rpx;
}

.hero-swiper {
  width: 100%;
  height: 400rpx;
  margin-bottom: 18rpx;
  border-radius: 16rpx;
  overflow: hidden;
}

.hero-img {
  width: 100%;
  height: 100%;
}

.info-card {
  background-color: #fff;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 6rpx 20rpx rgba(15, 23, 42, 0.06);
}

.vehicle-name {
  font-size: 34rpx;
  font-weight: 600;
  color: #1f2937;
  margin-bottom: 8rpx;
  display: block;
}

.vehicle-price {
  font-size: 42rpx;
  color: #ef4444;
  font-weight: 700;
  margin-bottom: 14rpx;
  display: block;
}

.tag-container {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.tag {
  background: #f3f4f6;
  padding: 8rpx 14rpx;
  border-radius: 14rpx;
  font-size: 22rpx;
  color: #4b5563;
}

.status-tag {
  background: #e8f2ff;
  color: #2563eb;
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #111827;
  margin-bottom: 14rpx;
  display: block;
}

.battery-container {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.battery-label {
  font-size: 24rpx;
  color: #4b5563;
  margin-right: 12rpx;
  min-width: 110rpx;
}

.battery-bar-container {
  flex: 1;
  height: 12rpx;
  background-color: #e5e7eb;
  border-radius: 6rpx;
  overflow: hidden;
  margin-right: 12rpx;
}

.battery-bar {
  height: 100%;
  border-radius: 6rpx;
}

.battery-percentage {
  font-size: 22rpx;
  color: #4b5563;
  min-width: 64rpx;
  text-align: right;
}

.description {
  font-size: 24rpx;
  color: #4b5563;
  line-height: 1.7;
}

.location-text {
  font-size: 24rpx;
  color: #4b5563;
  line-height: 1.6;
}

.button-group {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 20;
  display: flex;
  gap: 14rpx;
  padding: 14rpx 18rpx calc(14rpx + env(safe-area-inset-bottom));
  background: #ffffff;
  box-shadow: 0 -6rpx 20rpx rgba(15, 23, 42, 0.1);
}

.secondary-button,
.primary-button {
  margin: 0;
  height: 84rpx;
  line-height: 84rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
}

.secondary-button {
  flex: 1;
  background: #fff;
  color: #2563eb;
  border: 1rpx solid #93c5fd;
}

.secondary-button::after {
  border: 0;
}

.primary-button {
  flex: 2;
  background: #2563eb;
  color: #fff;
  border: 0;
}

.primary-button::after {
  border: 0;
}
