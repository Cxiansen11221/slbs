/* app.wxss */
@import './weui.wxss';
@import './styles/variables.wxss';

page {
  background-color: var(--color-background);
  font-family: 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
}

.container {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx;
  box-sizing: border-box;
}

.bike-card {
  width: 100%;
  margin-bottom: 20rpx;
  border-radius: var(--border-radius-lg);
  overflow: hidden;
  box-shadow: var(--box-shadow-sm);
  background-color: var(--color-white);
}

.bike-image {
  width: 100%;
  height: 300rpx;
  object-fit: cover;
  border-radius: var(--border-radius-lg) var(--border-radius-lg) 0 0;
}

.bike-info {
  padding: 20rpx;
  background-color: var(--color-white);
}

.bike-name {
  font-size: var(--font-size-title);
  font-weight: 500;
  margin-bottom: 10rpx;
  color: var(--color-text-primary);
  font-family: var(--font-medium);
}

.bike-price {
  font-size: var(--font-size-body);
  color: var(--color-error);
  font-weight: 500;
  margin-bottom: 10rpx;
  font-family: var(--font-medium);
}

.bike-address {
  font-size: 24rpx;
  color: var(--color-text-secondary);
  margin-bottom: 10rpx;
  font-family: var(--font-regular);
}

.bike-status {
  font-size: 24rpx;
  color: var(--color-text-tertiary);
  font-family: var(--font-regular);
}

.btn-primary {
  background-color: var(--color-primary);
  color: var(--color-white);
  border-radius: var(--border-radius-md);
  text-align: center;
  padding: 15rpx;
  font-size: var(--font-size-body);
  margin-top: 20rpx;
  font-family: var(--font-medium);
  transition: all 0.3s ease;
}

.btn-primary:active {
  background-color: var(--color-primary-dark);
  transform: scale(0.98);
}

.btn-secondary {
  background-color: var(--color-background);
  color: var(--color-text-primary);
  border-radius: var(--border-radius-md);
  text-align: center;
  padding: 15rpx;
  font-size: var(--font-size-body);
  margin-top: 10rpx;
  font-family: var(--font-regular);
  transition: all 0.3s ease;
}

.btn-secondary:active {
  background-color: var(--color-border);
  transform: scale(0.98);
}

.search-bar {
  display: flex;
  align-items: center;
  background-color: var(--color-background);
  border-radius: 20rpx;
  padding: 0 20rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid var(--color-border);
}

.search-input {
  flex: 1;
  padding: 15rpx 0;
  font-size: var(--font-size-body);
  border: none;
  background-color: transparent;
  color: var(--color-text-primary);
  font-family: var(--font-regular);
}

.search-input::placeholder {
  color: var(--color-text-tertiary);
}

.search-btn {
  padding: 15rpx;
  color: var(--color-primary);
  font-size: var(--font-size-body);
  font-family: var(--font-regular);
}

.tab-bar {
  display: flex;
  justify-content: space-around;
  padding: 20rpx 0;
  border-top: 1rpx solid var(--color-border);
  background-color: var(--color-white);
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  z-index: 100;
  box-shadow: 0 -2rpx 10rpx rgba(0, 0, 0, 0.1);
}

.tab-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  color: var(--color-text-tertiary);
  transition: all 0.3s ease;
}

.tab-item.active {
  color: var(--color-primary);
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
  margin-bottom: 5rpx;
}

.tab-text {
  font-size: 24rpx;
  font-family: var(--font-regular);
}

/* 加载状态 */
.loading {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 40rpx;
  color: var(--color-text-secondary);
  font-family: var(--font-regular);
  font-size: var(--font-size-body);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80rpx 20rpx;
  color: var(--color-text-tertiary);
  font-family: var(--font-regular);
  font-size: var(--font-size-body);
  text-align: center;
}

.empty-state image {
  width: 120rpx;
  height: 120rpx;
  margin-bottom: 20rpx;
  opacity: 0.5;
}

.empty-state text {
  margin-bottom: 10rpx;
}

/* 弹窗样式 */
.modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 9999;
}

.modal-content {
  background-color: var(--color-white);
  border-radius: var(--border-radius-lg);
  padding: 30rpx;
  width: 80%;
  box-shadow: var(--box-shadow-lg);
}

.modal-title {
  font-size: var(--font-size-title);
  font-weight: 500;
  color: var(--color-text-primary);
  margin-bottom: 20rpx;
  text-align: center;
  font-family: var(--font-medium);
}

.modal-body {
  font-size: var(--font-size-body);
  color: var(--color-text-secondary);
  margin-bottom: 30rpx;
  line-height: 1.5;
  font-family: var(--font-regular);
}

.modal-buttons {
  display: flex;
  justify-content: space-between;
  gap: 15rpx;
}

.modal-button {
  flex: 1;
  padding: 15rpx;
  border-radius: var(--border-radius-md);
  text-align: center;
  font-size: var(--font-size-body);
  font-family: var(--font-medium);
  transition: all 0.3s ease;
}

.modal-button.primary {
  background-color: var(--color-primary);
  color: var(--color-white);
}

.modal-button.primary:active {
  background-color: var(--color-primary-dark);
  transform: scale(0.98);
}

.modal-button.secondary {
  background-color: var(--color-background);
  color: var(--color-text-primary);
  border: 1rpx solid var(--color-border);
}

.modal-button.secondary:active {
  background-color: var(--color-border);
  transform: scale(0.98);
}
